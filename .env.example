# Copy this file to .env and fill in real values. .env is in .gitignore, so it never reaches GitHub.

# MongoDB connection string (Atlas or local). The database name is forced to
# comp3123_assignment1 in config/db.js, so it doesn't matter what (if anything) is after the "/".
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Local alternative: MONGODB_URI=mongodb://127.0.0.1:27017

# Long random string used to sign JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=1h

PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Optional: max login/signup attempts per IP per 15 minutes (default 20). Lower it to demo the 429.
# AUTH_RATE_LIMIT_MAX=20
# Optional: set to 1 when deployed behind a proxy so rate limiting sees real client IPs.
# TRUST_PROXY=1
